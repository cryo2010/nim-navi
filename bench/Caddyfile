{
	# Serves the navi protocol matrix over h1/h2/h3 on one TLS listener. Uses the
	# cert run.sh generates (exported as NAVI_BENCH_CERT / NAVI_BENCH_KEY).
	auto_https off
	servers {
		protocols h1 h2 h3
	}
}

https://localhost:4433 {
	tls {$NAVI_BENCH_CERT} {$NAVI_BENCH_KEY}
	header Alt-Svc `h3=":4433"; ma=86400`
	encode gzip
	respond "navi protocol bench ok" 200
}
